<?xml version="1.0"?>
<robot name="two_link_planar">

<!-- Base -->
<link name="base_link">
  <inertial>
    <origin xyz="0 0 0"/>
    <mass value="1"/>
    <inertia ixx="0.01" ixy="0" ixz="0"
             iyy="0.01" iyz="0" izz="0.01"/>
  </inertial>
</link>

<!-- First arm link -->
<link name="link1">
  <visual>
    <origin xyz="0.5 0 0"/>
    <geometry>
      <box size="1 0.1 0.1"/>
    </geometry>
  </visual>

  <collision>
    <origin xyz="0.5 0 0"/>
    <geometry>
      <box size="1 0.1 0.1"/>
    </geometry>
  </collision>

  <inertial>
    <origin xyz="0.5 0 0"/>
    <mass value="1"/>
    <inertia ixx="0.01" ixy="0" ixz="0"
             iyy="0.09" iyz="0" izz="0.09"/>
  </inertial>
</link>

<!-- Joint 1 -->
<joint name="joint1" type="revolute">
  <parent link="base_link"/>
  <child link="link1"/>
  <origin xyz="0 0 0"/>
  <axis xyz="0 0 1"/>
  <limit lower="-3.14" upper="3.14"
         effort="10" velocity="5"/>
</joint>

<!-- Second arm link -->
<link name="link2">
  <visual>
    <origin xyz="0.5 0 0"/>
    <geometry>
      <box size="1 0.1 0.1"/>
    </geometry>
  </visual>

  <collision>
    <origin xyz="0.5 0 0"/>
    <geometry>
      <box size="1 0.1 0.1"/>
    </geometry>
  </collision>

  <inertial>
    <origin xyz="0.5 0 0"/>
    <mass value="1"/>
    <inertia ixx="0.01" ixy="0" ixz="0"
             iyy="0.09" iyz="0" izz="0.09"/>
  </inertial>
</link>

<!-- Joint 2 -->
<joint name="joint2" type="revolute">
  <parent link="link1"/>
  <child link="link2"/>
  <origin xyz="1 0 0"/>
  <axis xyz="0 0 1"/>
  <limit lower="-3.14" upper="3.14"
         effort="10" velocity="5"/>
</joint>

<!-- Gripper link -->
<link name="link3">
  <visual>
    <geometry>
      <sphere radius="0.05"/>
    </geometry>
  </visual>

  <collision>
    <geometry>
      <sphere radius="0.05"/>
    </geometry>
  </collision>
</link>

<!-- Joint 3 -->
<joint name="joint3" type="fixed">
  <parent link="link2"/>
  <child link="link3"/>
  <origin xyz="1 0 0"/>
</joint>

</robot>


